# Copy this file to .env.local for local testing. NEVER commit real keys.
# On Vercel, add these under Project → Settings → Environment Variables instead.

# Required: your free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: which Gemini model to use (default: gemini-flash-latest)
# GEMINI_MODEL=gemini-flash-latest

# Optional: max generations per visitor per day (default: 20)
# DAILY_LIMIT_PER_VISITOR=20
